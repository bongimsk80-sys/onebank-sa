generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Multi-tenancy ────────────────────────────────────────────────────────────

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("beta")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  bankAccounts      BankAccount[]
  transactions      Transaction[]
  payments          Payment[]
  beneficiaries     Beneficiary[]
  approvalWorkflows ApprovalWorkflow[]
  transferLimits    TransferLimit[]
  activityLogs      ActivityLog[]
  notifications     Notification[]
  erpConnections    ErpConnection[]
  erpInvoices       ErpInvoice[]

  @@map("organisations")
}

// ─── Core models ──────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  password           String
  role               String    @default("viewer")
  isActive           Boolean   @default(true)
  isVerified              Boolean   @default(false)
  verificationToken       String?
  resetToken              String?
  resetTokenExpiry        DateTime?
  inviteToken             String?
  hasCompletedOnboarding  Boolean   @default(false)
  organisationId          String?
  organisation       Organisation? @relation(fields: [organisationId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("users")
}

model BankAccount {
  id             String        @id @default(cuid())
  bank           String
  accountNumber  String
  accountType    String
  balance        Float         @default(0)
  currency       String        @default("ZAR")
  color          String
  isActive       Boolean       @default(true)
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]

  @@map("bank_accounts")
}

model Transaction {
  id             String       @id @default(cuid())
  name           String
  type           String
  amount         Float
  date           DateTime     @default(now())
  bank           String
  accountNumber  String
  reference      String
  status         String       @default("completed")
  bankAccount    BankAccount? @relation(fields: [bankAccountId], references: [id])
  bankAccountId  String?
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("transactions")
}

model Payment {
  id             String    @id @default(cuid())
  beneficiary    String
  bank           String
  amount         Float
  type           String
  status         String    @default("pending")
  initiatedBy    String
  date           DateTime  @default(now())
  reference      String
  description    String
  priority       Boolean   @default(false)
  scheduledDate  DateTime?
  isScheduled    Boolean   @default(false)
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("payments")
}

model Beneficiary {
  id              String    @id @default(cuid())
  name            String
  type            String
  category        String
  status          String    @default("active")
  accountNumber   String
  bank            String
  branchCode      String
  totalPayments   Int       @default(0)
  lastPayment     Float     @default(0)
  lastPaymentDate DateTime?
  tag             String
  organisationId  String?
  organisation    Organisation? @relation(fields: [organisationId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("beneficiaries")
}

model ApprovalWorkflow {
  id             String   @id @default(cuid())
  name           String
  description    String
  minAmount      Float    @default(0)
  maxAmount      Float    @default(999999999)
  steps          String
  isActive       Boolean  @default(true)
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("approval_workflows")
}

model TransferLimit {
  id             String   @id @default(cuid())
  role           String   @unique
  dailyLimit     Float    @default(0)
  perTxLimit     Float    @default(0)
  monthlyLimit   Float    @default(0)
  isActive       Boolean  @default(true)
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("transfer_limits")
}

model ActivityLog {
  id             String   @id @default(cuid())
  action         String
  description    String
  userId         String?
  userName       String?
  entityType     String?
  entityId       String?
  ipAddress      String?
  status         String   @default("success")
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  createdAt      DateTime @default(now())

  @@map("activity_logs")
}

model Notification {
  id             String   @id @default(cuid())
  title          String
  message        String
  type           String   @default("info")
  read           Boolean  @default(false)
  userId         String?
  link           String?
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("notifications")
}

model ErpConnection {
  id             String    @id @default(cuid())
  name           String
  provider       String
  status         String    @default("disconnected")
  apiKey         String?
  apiUrl         String?
  lastSyncedAt   DateTime?
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("erp_connections")
}

model ErpInvoice {
  id             String   @id @default(cuid())
  erpProvider    String
  invoiceNumber  String
  vendor         String
  amount         Float
  dueDate        DateTime
  status         String   @default("pending")
  paymentId      String?
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("erp_invoices")
}

// ─── Platform-level models (no org scope) ─────────────────────────────────────

model Feedback {
  id         String   @id @default(cuid())
  rating     Int
  categories String   @default("[]")
  message    String?
  page       String?
  userName   String?
  userRole   String?
  createdAt  DateTime @default(now())

  @@map("feedback")
}

model PlatformMetric {
  id                    String   @id @default(cuid())
  date                  DateTime @default(now())
  metricType            String
  totalTransactions     Int      @default(0)
  totalTransactionValue Float    @default(0)
  totalPayments         Int      @default(0)
  totalPaymentValue     Float    @default(0)
  totalUsers            Int      @default(0)
  totalBeneficiaries    Int      @default(0)
  bankBreakdown         String   @default("[]")
  roleBreakdown         String   @default("[]")
  statusBreakdown       String   @default("[]")
  peakHour              Int?
  avgPaymentSize        Float    @default(0)
  approvedPayments      Int      @default(0)
  rejectedPayments      Int      @default(0)
  settledPayments       Int      @default(0)
  pendingPayments       Int      @default(0)
  createdAt             DateTime @default(now())

  @@map("platform_metrics")
}
